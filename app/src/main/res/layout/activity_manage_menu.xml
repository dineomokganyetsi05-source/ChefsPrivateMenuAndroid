<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHEF'S"
            android:textColor="#D4B76A"
            android:textSize="16sp"
            android:letterSpacing="0.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MANAGE MENU"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your restaurant dishes"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Search dishes..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#D4B76A"
            android:padding="12dp"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/courseFilterSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#D4B76A" />

        <TextView
            android:id="@+id/resultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 dishes found"
            android:textColor="#D4B76A"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/menuItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No dishes added yet."
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Dashboard"
            android:textColor="#0B0B0B"
            android:backgroundTint="#D4B76A"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>